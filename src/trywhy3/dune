; glob_files_rec and find are doing the same work, but ...
(rule
 (deps
  (glob_files ../../stdlib/*.mlw)
  (glob_files ../../stdlib/mach/*.mlw)
  (glob_files ../../stdlib/mach/java/*.mlw)) ; use glob_files_rec with dune 3.0
 (action
  (with-stdout-to flags.inc
   (chdir ../..
    (progn
     (echo "(\n")
     (run find stdlib -name *.mlw -exec printf " --file=%\%{dep:../../%s}:/%s\n" {} {} ";")
     (echo ")\n"))))))

(library
 (name trywhy3_shared)
 (modules bindings worker_proto)
 (wrapped false)
 (preprocess (pps js_of_ocaml-ppx))
 (libraries js_of_ocaml))

(executable
 (name trywhy3)
 (modes js)
 (preprocess (pps js_of_ocaml-ppx))
 (js_of_ocaml
  (flags --Werror))
 (libraries trywhy3_shared js_of_ocaml menhirLib)
 (modules json_base json_parser json_lexer shortener trywhy3))

(rule
 (alias trywhy3)
 (mode (promote (until-clean)))
 (action (copy trywhy3.bc.js trywhy3.js)))

(executable
 (name why3_worker)
 (modes js)
 (flags :standard -linkall)
 (js_of_ocaml
  (flags --Werror +dynlink.js +toplevel.js
     --extern-fs --file=%{dep:trywhy3.conf}:/
     --file=%{dep:try_alt_ergo.drv}:/
     (:include flags.inc)))
 (libraries trywhy3_shared python microc why3 zarith_stubs_js)
 (modules why3_worker))

(rule
 (alias trywhy3)
 (mode (promote (until-clean)))
 (action (copy why3_worker.bc.js why3_worker.js)))
