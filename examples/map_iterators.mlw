(** {2 Testing iterator on maps indexed by strings} *)

module TestStringMapIterator

  use int.Int

  use set.Fset as S
  use fmap.MapAppString as M

  let incr_str (s : M.t int) : (r : M.t int)
    ensures { forall k:string. M.mem k s -> s k >= 0 -> M.mem k r && r k = s k + 1 }
    ensures { forall k:string. M.mem k r -> M.mem k s && s k >= 0 && r k = s k + 1 }
  =
    let ref acc = M.create () in
    for x in s with M.Iter do
      invariant { forall k. M.mem k acc -> M.mem k s && s k >= 0 && acc k = s k + 1 }
      invariant { forall k. S.mem k it.M.Iter.visited -> s k >= 0 -> M.mem k acc && acc k = s k + 1 }
      variant { S.cardinal (M.domain s) - S.cardinal it.M.Iter.visited }
      let (k,v) = x in
      if v >= 0 then acc <- M.add k (v+1) acc
    done;
    acc


end
