
(** {VerifyThis 2026, challenge 2 Particle simulation}

  Team YYY (Jean-Christophe Filliâtre)

  Notes:
  - No concurrency in Why3

  Summary:
  - Task 1.1 completed (see the preconditions in Bags' functions)
  - Task 1.2 completed (for loops always terminates + a variant for `iter`)
  - Task 1.3 skipped (not meaningful for Why3)
  - Task 2.1 stated but not fully verified
  - Task 2.2 not attempted

*)

(** Here we model *arrays of mutable sets* rather than mutable sets,
    because Why3 does not allow arrays of mutable data structures.

    Beside, we model sets rather than bags, despite the name, because
    the challenge statement assumes all elements to be distinct. *)

module Bags

  use int.Int
  use set.Fset

  type elt
    (* = int64, but we don't say it *)

  type set = fset elt

  type bags = abstract {
    size: int;
    mutable content: int -> set;
  }
  invariant { size >= 0 }
  (* all distinct *)
  invariant { forall i j. 0 <= i < size -> 0 <= j < size -> i <> j ->
                          disjoint (content i) (content j) }
  by { size = 0; content = (fun _ -> empty); }

  meta coercion function content
    (* so that we can write `b i` for `b.content i` *)

  val create (n: int) : (b: bags)
    requires { n >= 0 }
    ensures  { b.size = n }
    ensures  { forall i. 0 <= i < n -> forall x. not mem x (b i) }

  val atomic_push (b: bags) (i: int) (x: elt) : unit
    requires { 0 <= i < b.size }
    requires { forall j. 0 <= j < b.size -> not mem x (b j) }
    writes   { b }
    ensures  { mem x (b i) }
    ensures  { forall j y. 0 <= j < b.size ->
               (j <> i \/ y <> x) -> mem y (b j) = old (mem y (b j)) }

  val nonatomic_push (b: bags) (i: int) (x: elt) : unit
    requires { 0 <= i < b.size }
    requires { forall j. 0 <= j < b.size -> not mem x (b j) }
    writes   { b }
    ensures  { mem x (b i) }
    ensures  { forall j y. 0 <= j < b.size ->
               (j <> i \/ y <> x) -> mem y (b j) = old (mem y (b j)) }

  val transfer (b1: bags) (i: int) (b2: bags) (j: int) : unit
    requires { 0 <= i < b1.size }
    requires { 0 <= j < b2.size }
    requires { forall k. 0 <= k < b2.size -> disjoint (b1 i) (b2 k) }
    writes   { b1, b2 }
    ensures  { forall x. not mem x (b1 i) } (* b1 i emptied *)
    ensures  { forall k x. 0 <= k < b1.size -> k <> i ->
               mem x (b1 k) = old (mem x (b1 k)) }
    ensures  { forall x. mem x (b2 j) <-> (old (mem x (b1 i)) \/ old (mem x (b2 j))) }
    ensures  { forall k x. 0 <= k < b2.size -> k <> j -> mem x (b2 k) = old (mem x (b2 k)) }

  val clear (b: bags) (i: int) : unit
    requires { 0 <= i < b.size }
    writes   { b}
    ensures  { forall x. not mem x (b i) }
    ensures  { forall j x. 0 <= j < b.size -> j <> i -> mem x (b j) = old (mem x (b j)) }

  (* interface to use the `for each` loop of Why3 *)
  scope Iter

    type t = abstract {
              initial: set;
      mutable visited: set;
    } invariant {
      subset visited initial
    } by {
      initial = empty;
      visited = empty;
    }

    val create (bi: (bags, int)) : t
      requires { let b, i = bi in 0 <= i < b.size }
      ensures  { let b, i = bi in result.initial = b i }
      ensures  { is_empty result.visited }

    exception Done

    val next (iter: t) : elt
      writes { iter }
      raises  { Done ->  iter.initial = (old iter).visited /\
                         iter.visited = (old iter).visited }
      returns { r -> mem r iter.initial /\
                     not (mem r (old iter).visited) /\
                     iter.visited = add r (old iter).visited }

  end

end

module Challenge2

  use map.Map
  use int.Int
  use int.Iter
  use set.Fset
  use Bags

  val constant _N: int
    ensures { result >= 1 }

  val function f (i: int) (x: elt) : (j: int)
    requires { 0 <= i < _N }
    ensures  { 0 <= j < _N }

  function fx (x: elt) : int -> int = fun i -> f i x

  predicate good_moves_ (i: int) (cur1 cur2: bags) (k: int) (where: elt -> int) =
    forall x. mem x (cur1 i) -> 0 <= where x < cur2.size
                             /\ where x = iter (fx x) k i
                             /\ mem x (cur2 (where x))

  predicate good_moves (cur1 cur2: bags) (k: int) (where: elt -> int) =
    forall i. 0 <= i < cur1.size -> good_moves_ i cur1 cur2 k where

  let compute (cur: bags) (_K: int) (ghost ref where: elt -> int) : unit
    requires { cur.size = _N }
    requires { _K >= 0 }
    requires { good_moves cur cur 0 where }
    ensures  { good_moves (old cur) cur _K where }
  = let next_private = create _N in
    let next_shared  = create _N in
    for k = 0 to _K - 1 do
      invariant { forall i. 0 <= i < _N -> is_empty (next_private i) }
      invariant { forall i. 0 <= i < _N -> is_empty (next_shared  i) }
      invariant { good_moves (old cur) cur k where }
      for i = 0 to _N - 1 do
        invariant { forall j. i <= j < _N -> forall j'. 0 <= j' < _N ->
                    disjoint (cur j) (next_private j') /\
                    disjoint (cur j) (next_shared  j') }
        invariant { forall j. 0 <= j < i -> forall x. mem x (cur j) ->
                    if f j x = j then mem x (next_private j      )
                                 else mem x (next_shared  (f j x)) }
        (* for `iter`, we use for `for each` loop of Why3 *)
        for x in (cur, i) with Bags.Iter do
          variant { cardinal (cur i) - cardinal it.Bags.Iter.visited } (* task 1.2 *)
          let j = f i x in
          where <- where[x <- j];
          if j = i then nonatomic_push next_private i x
                   else    atomic_push next_shared  j x
        done
      done;
      for i = 0 to _N - 1 do
        invariant { forall j. 0 <= j < i -> is_empty (next_private j) }
        invariant { forall j. 0 <= j < i -> is_empty (next_shared  j) }
        clear cur i;
        transfer next_private i cur i;
        transfer next_shared  i cur i;
      done;
    done

end

(** Below we make a straightforward implementation of the interface `Bags`
    in order to ensure its consistency.

    Note: In the process, we found two bugs in the interface `Bags` above!
    (some preconditions were not strong enough to maintain the invariants) *)

module BagsImpl : Bags

  use map.Map
  use int.Int
  use array.Array
  clone set.SetApp as S
  use set.Fset

  type elt = S.elt
  type set = fset elt

  type bags = {
    size: int;
    bags: array S.set;
    mutable ghost content: int -> set;
  }
  invariant { size = length bags }
  (* all distinct *)
  invariant { forall i j. 0 <= i < size -> 0 <= j < size -> i <> j ->
                          disjoint (content i) (content j) }
  (* gluing invariant *)
  invariant { forall i. 0 <= i < size ->
              forall x. S.mem x bags[i] <-> Fset.mem x (content i) }
  by { size = 0; bags = Array.make 0 (S.empty ());
       content = (fun _ -> Fset.empty); }

  meta coercion function content

  let create (n: int) : (b: bags)
    requires { n >= 0 }
    ensures  { b.size = n }
    ensures  { forall i. 0 <= i < n -> forall x. not mem x (b i) }
  = { size = n;
      bags = Array.make n (S.empty ());
      content = (fun _ -> Fset.empty); }

  let atomic_push (b: bags) (i: int) (x: elt) : unit
    requires { 0 <= i < b.size }
    requires { forall j. 0 <= j < b.size -> not mem x (b j) }
    writes   { b, b.bags }
    ensures  { mem x (b i) }
    ensures  { forall j y. 0 <= j < b.size ->
               (j <> i \/ y <> x) -> mem y (b j) = old (mem y (b j)) }
  = b.bags[i] <- S.add x b.bags[i];
    b.content <- Map.set b.content i (Fset.add x (b.content i))

  let nonatomic_push (b: bags) (i: int) (x: elt) : unit
    requires { 0 <= i < b.size }
    requires { forall j. 0 <= j < b.size -> not mem x (b j) }
    writes   { b, b.bags }
    ensures  { mem x (b i) }
    ensures  { forall j y. 0 <= j < b.size ->
               (j <> i \/ y <> x) -> mem y (b j) = old (mem y (b j)) }
  = b.bags[i] <- S.add x b.bags[i];
    b.content <- Map.set b.content i (Fset.add x (b.content i))

  let transfer (b1: bags) (i: int) (b2: bags) (j: int) : unit
    requires { 0 <= i < b1.size }
    requires { 0 <= j < b2.size }
    requires { forall k. 0 <= k < b2.size -> disjoint (b1 i) (b2 k) }
    writes   { b1, b1.bags, b2, b2.bags }
    ensures  { forall x. not mem x (b1 i) } (* b1 i emptied *)
    ensures  { forall k x. 0 <= k < b1.size -> k <> i ->
               mem x (b1 k) = old (mem x (b1 k)) }
    ensures  { forall x. mem x (b2 j)
                     <-> (old (mem x (b1 i)) \/ old (mem x (b2 j))) }
    ensures  { forall k x. 0 <= k < b2.size -> k <> j ->
               mem x (b2 k) = old (mem x (b2 k)) }
  = b2.bags[j] <- S.union b1.bags[i] b2.bags[j];
    b2.content <- Map.set b2.content j (Fset.union (b1.content i) (b2.content j));
    b1.bags[i] <- S.empty ();
    b1.content <- Map.set b1.content i Fset.empty

  let clear (b: bags) (i: int) : unit
    requires { 0 <= i < b.size }
    writes   { b, b.bags }
    ensures  { forall x. not mem x (b i) }
    ensures  { forall j x. 0 <= j < b.size -> j <> i ->
               mem x (b j) = old (mem x (b j)) }
  = b.bags[i] <- S.empty ();
    b.content <- Map.set b.content i Fset.empty

  scope Iter

    type t = {
      mutable          todo: S.set;
              ghost initial: set;
      mutable ghost visited: set;
    }
    invariant { subset visited initial }
    invariant { Fset.disjoint todo visited }
    invariant { Fset.union (S.to_fset todo) visited == initial }
    by {
         todo = S.empty ();
      initial = Fset.empty;
      visited = Fset.empty;
    }

    let create (bi: (bags, int)) : t
      requires { let b, i = bi in 0 <= i < b.size }
      ensures  { let b, i = bi in result.initial = b i }
      ensures  { is_empty result.visited }
    = let b, i = bi in
      { todo = b.bags[i]; initial = S.to_fset b.bags[i]; visited = Fset.empty }

    exception Done

    let next (iter: t) : elt
      writes  { iter }
      raises  { Done ->  iter.initial = (old iter).visited /\
                         iter.visited = (old iter).visited }
      returns { r -> mem r iter.initial /\
                     not (mem r (old iter).visited) /\
                     iter.visited = add r (old iter).visited }
   = if S.is_empty iter.todo then raise Done;
     let x = S.choose iter.todo in
     iter.todo <- S.remove x iter.todo;
     iter.visited <- Fset.add x iter.visited;
     return x

  end

end
