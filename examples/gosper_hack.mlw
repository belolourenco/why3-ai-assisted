
(** Gosper's Hack

   Iterates over all `n`-bit words with `k` bits set, in lexicographic
   order and in linear time, with O(1) cheap operations to move from
   one word to the next.

   Said otherwise, iterates over all subsets of `{0,1,...,n-1}` of
   size `k`, where each subset is represented as a bit vector.
  {h<pre>
   Principle: Identify the rightmost segment of 1 bits,
                                  i
         w = ?????????000000111111100000
                            <- m ->

   Isolate its rightmost bit, at position i, with w&-w:
                                  i
         c = 000000000000000000000100000

   Add it to w, to get the following:
                                  i
         r = ?????????000001000000000000
                            <- m ->

   XOR r and w, to get the following:
                                  i
       r^w = 000000000000001111111100000
                           <  m+1 >

   Shift this to the right i+2 times (using shift and division by c):
                                  i
             00000000000000000000111111
                                 < m-1>

   Finally, OR this with r to get the expected word:

             ?????????00000100000111111
                                 < m-1>
  </pre>}

   Works for 0 <= k <= n <= Sys.int_size.

   Gosper's Hack is explained in Hacker's Delight (Henri Warren,
   Addison-Wesley, 2013); see pages 14--15.
*)

(** Bit vectors *)
module BV

  use int.Int

  val constant word_size: int
    ensures { 0 < result }

  type bv = abstract {
    bits: int -> bool;
  }
  meta coercion function bits

  predicate (==) (x y: bv)
  = forall i. 0 <= i < word_size -> x i = y i

  axiom extensionality: forall x y. x == y <-> x = y

  val (=) (x y: bv) : bool
    ensures { result <-> x = y }
    ensures { result -> x == y }

end

module Spec

  use int.Int
  use int.NumOf
  use seq.Seq
  use BV

  function pop (x: bv) : int
  = numof x 0 word_size

  (** a valid bit vector has exactly `k` bits set in the range
      `0..n` and no bit set beyond *)
  predicate valid (n k: int) (x: bv)
  = 0 <= k <= n <= word_size /\
    pop x = k /\
    forall i. n <= i < word_size -> not x i

  predicate zeros (x: bv) (lo hi: int)
  = forall i. lo <= i < hi -> not x i

  predicate ones (x: bv) (lo hi: int)
  = forall i. lo <= i < hi -> x i

  predicate same (x y: bv) (lo hi: int)
  = forall i. lo <= i < hi -> x i = y i

  predicate is_first (n k: int) (x: bv)
  = ones x 0 k /\ zeros x k n

  predicate is_last (n k: int) (x: bv)
  = zeros x 0 (n-k) /\ ones x (n-k) n

  (** bit vectors are ordered lexicographically *)
  predicate lt (x y: bv)
  = exists i. 0 <= i < word_size /\
    not x i /\ y i /\ same x y i word_size

  predicate le (x y: bv)
  = x = y \/ lt x y

  let lemma lt_trans (x y z: bv)
    requires { lt x y } requires { lt y z } ensures { lt x z }
  = ()

  let lemma first_is_first (n k: int) (x f: bv)
    requires { 0 <= k <= n <= word_size }
    requires { valid n k f }
    requires { is_first n k f }
    requires { valid n k x }
    ensures  { not lt x f }
  = ()

  let lemma last_is_last (n k: int) (l x: bv)
    requires { 0 <= k <= n <= word_size }
    requires { valid n k l }
    requires { is_last n k l }
    requires { valid n k x }
    ensures  { not lt l x }
  = ()

  predicate is_next (n k: int) (x y: bv)
  = lt x y /\ valid n k y /\
    forall z. valid n k z -> not (lt x z /\ lt z y)

end

module Intf

  use int.Int
  use seq.Seq
  use BV
  use Spec

  val first (n k: int) : (x: bv)
    requires { 0 <= k <= n <= word_size }
    ensures  { valid n k x }
    ensures  { is_first n k x }

  val last (n k: int) : (x: bv)
    requires { 0 <= k <= n <= word_size }
    ensures  { valid n k x }
    ensures  { is_last n k x }

  val next (ghost n k: int) (x: bv) : (y: bv)
    requires { 0 <= k <= n <= word_size }
    requires { valid n k x }
    requires { not is_last n k x }
    ensures  { is_next n k x y }

end

(** the interface above is all we need to iterate over all the subsets *)
module Iter

  use int.Int
  use seq.Seq
  use BV
  use Spec
  use Intf

  type visited = seq bv

  (** a good sequence contains subsets from `first`, in order,
      without omission (but not necessarily up to `last`) *)
  predicate good_sequence (n k: int) (v: visited)
  = let len = length v in
    len >= 1 /\
    (forall i. 0 <= i < len -> valid n k v[i]) /\
    is_first n k v[0] /\
    forall i. 0 <= i < len-1 -> is_next n k v[i] v[i+1]

  let lemma good_sequence_is_sorted (n k: int) (v: visited)
    requires { good_sequence n k v }
    ensures  { forall i j. 0 <= i < j < length v -> lt v[i] v[j] }
  = let len = length v in
    for i = 0 to len-1 do
      invariant { forall i'. 0 <= i' < i ->
                  forall j'. i' < j' < len -> lt v[i'] v[j'] }
      for j = i+1 to len-1 do
        invariant { forall j'. i < j' < len -> lt v[i] v[j'] }
        ()
      done
    done

  let iter (n k: int) : (r: unit, ghost v: visited)
    requires { 0 <= k <= n <= word_size }
    ensures  { good_sequence n k v }
    ensures  { is_last n k v[length v - 1] }
    diverges
  = let ref w = first n k in
    let last = last n k in
    (* visit w *)
    let ghost ref v = singleton w in
    while not w = last do
      invariant { good_sequence n k v }
      invariant { length v >= 1 && v[length v - 1] = w }
      w <- next n k w;
      (* visit w *)
      v <- snoc v w
    done;
    return (), v

  (* note: the code would be nicer with `do while` loop *)

end

module MoreBV

  use int.Int
  use export BV
  use Spec

  val constant zero: bv
    ensures { zeros result 0 word_size }

  val constant one: bv
    ensures { result 0 }
    ensures { zeros result 1 word_size }

  val lsl (x: bv) (n: int) : (r: bv)
    requires { 0 <= n <= word_size }
    ensures  { zeros r 0 n }
    ensures  { forall i. n <= i < word_size -> r i = x (i - n) }

  val minus1 (x: bv) (ghost i: int) : (r: bv)
    requires { 0 <= i <= word_size }
    (* x = 2^i *)
    requires { zeros x 0 i }
    requires { i < word_size -> x i }
    requires { zeros x (i+1) word_size }
    ensures  { ones r 0 i }
    ensures  { zeros r i word_size }
    ensures  { pop r = i }

end

module Impl : Intf

  use int.Int
  use int.NumOf
  use MoreBV
  use Spec

  let first (n k: int) : (x: bv)
    requires { 0 <= k <= n <= word_size }
    ensures  { valid n k x }
    ensures  { is_first n k x }
    ensures  { zeros x k word_size }
  = minus1 (lsl one k) (ghost k)

  let lemma numof_ones (x: bv) (i j: int)
    requires { 0 <= i <= j <= word_size }
    requires { ones x i j }
    ensures  { numof x i j = j - i }
  = ()

  let lemma numof_zeros (x: bv) (i j: int)
    requires { 0 <= i <= j <= word_size }
    requires { zeros x i j }
    ensures  { numof x i j = 0 }
  = ()

  let last (n k: int) : (x: bv)
    requires { 0 <= k <= n <= word_size }
    ensures  { valid n k x }
    ensures  { is_last n k x }
  = let f = first n k in
    let l = lsl f (n - k) in
    numof_zeros l 0 (n-k);
    numof_ones  l (n-k) n;
    numof_zeros l n word_size;
    return l

  val next (ghost n k: int) (x: bv) : (y: bv)
    requires { 0 <= k <= n <= word_size }
    requires { valid n k x }
    requires { not is_last n k x }
    ensures  { is_next n k x y }

(* let next w = *)
(*   let c = w land -w in *)
(*   let r = w + c in *)
(*   (((r lxor w) lsr 2) / c) lor r *)

end
