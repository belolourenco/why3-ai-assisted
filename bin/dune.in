;; Why3

(rule
 (alias install_local)
 (mode (promote (until-clean)))
 (action (copy ../src/tools/main.exe why3%{ext_exe})))

(rule
 (alias opt)
 (mode (promote (until-clean)))
 (action (copy ../src/tools/main.exe why3.opt)))

(rule
 (alias byte)
 (mode (promote (until-clean)))
 (action (copy ../src/tools/main.bc why3.byte)))

(rule
 (alias opt)
 (mode (promote (until-clean)))
 (action (copy ../src/isabelle-client/isabelle_client_main.exe isabelle_client.opt)))

(rule
 (alias byte)
 (mode (promote (until-clean)))
 (action (copy ../src/isabelle-client/isabelle_client_main.bc isabelle_client.byte)))

