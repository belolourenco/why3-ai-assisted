; why3ide is an "(executable (mode plugin))", dune don't accept building both
; cma and cmxs, but only the "best" ones. Surprisingly, it seems to always
; call the file why3ide.cmxs, even in the bytecode-only case, where it is
; really a cma file
(rule
 (alias byte)
 (mode (promote (until-clean)))
 (enabled_if (= @enable_ide@ yes))
 (action (copy ../src/ide/why3ide.cmxs why3ide%{ext_plugin})))

; factor this with the above using (aliases) field when available (dune 3.5)
(alias
 (name opt)
 (deps why3ide.cmxs)
 (enabled_if (= @enable_ide@ yes)))

(rule
 (alias byte)
 (mode (promote (until-clean)))
 (action (copy ../src/ide/why3webserver.cma why3webserver.cma)))

(rule
 (alias opt)
 (mode (promote (until-clean)))
 (action (copy ../src/ide/why3webserver.cmxs why3webserver.cmxs)))
