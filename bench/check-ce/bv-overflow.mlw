

module T8

use bv.BV8
use mach.bv.BVCheck8

let tuadd (x:t) (y:t) : t = u_add x y
let tsadd (x:t) (y:t) : t = s_add x y
let tusub (x:t) (y:t) : t = u_sub x y
let tssub (x:t) (y:t) : t = s_sub x y
let tumul (x:t) (y:t) : t = u_mul x y
let tsmul (x:t) (y:t) : t = s_mul x y
let tsneg (x:t) : t = s_neg x
let tudiv (x:t) (y:t) : t = u_div x y
let tsdiv (x:t) (y:t) : t = s_div x y
let turem (x:t) (y:t) : t = u_rem x y
let tsrem (x:t) (y:t) : t = s_rem x y

end

